					{"triggers": [{"kind": "datapoint", "datapoint": "x.c"}], "actions": [], "to": "busy"}
				]
			}
		]}},
		{"at": 125000, "check": {"states": {"stairs": "off"}, "persisted": {"stairs/.state": "off", "hall/.state": "idle"}}}
	],
	"end": 200000,
	"expected": {
		"commands": [
			{"at": 0, "rule": "stairs", "datapoint": "stairs.light", "value": 0.0},
			{"at": 1000, "rule": "stairs", "datapoint": "stairs.light", "value": 100.0},
			{"at": 90000, "rule": "stairs", "datapoint": "stairs.light", "value": 0.0},
			{"at": 100000, "rule": "stairs", "datapoint": "stairs.light", "value": 100.0},
			{"at": 110000, "rule": "stairs", "datapoint": "stairs.light", "value": 0.0}
