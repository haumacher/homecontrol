			"reactions": [
				{
					"triggers": [{"kind": "datapoint", "datapoint": "in.x"}],
					"actions": [{"kind": "write", "datapoint": "out.y", "value": {"kind": "parameter", "id": "max helligkeit"}}]
				}
			]
		}
	],
	"end": 0,
	"expected": {"loadRefused": "malformed"}
}
