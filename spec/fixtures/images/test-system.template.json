		"timeMaster": {"time": "GA:time", "interval": 600, "atMidnight": true}
	},
	"schedules": [
		{"id": "pulseD", "label": "Channel D every 10 minutes", "kind": "interval", "every": 600000,
		 "from": {"hour": 0, "minute": 0, "second": 0}, "until": {"hour": 23, "minute": 50, "second": 0},
		 "comment": "Switches channel D on; the rule autoOffD switches it off after two minutes."}
	],
	"rules": [
		{
			"id": "key3TogglesC",
			"name": "Key 3 toggles channel C",
			"comment": "Every telegram from key 3 inverts channel C's reported state, whatever value the key sends.",
			"reactions": [
				{
					"triggers": [{"kind": "datapoint", "datapoint": "key3", "on": "update", "origin": "report"}],
					"actions": [{"kind": "write", "datapoint": "chC", "value": {"kind": "unary", "op": "not",
						"operand": {"kind": "call", "function": "coalesce",
							"args": [{"kind": "datapoint", "name": "chC.state"}, {"kind": "literal", "type": "boolean", "value": false}]}}}]
				}
			]
		},
		{
			"id": "scheduleD",
			"name": "Schedule switches channel D on",
			"reactions": [
				{
					"triggers": [{"kind": "schedule", "schedule": "pulseD"}],
					"actions": [{"kind": "write", "datapoint": "chD", "value": {"kind": "literal", "type": "boolean", "value": true}}]
				}
			]
		},
		{
			"id": "autoOffD",
			"name": "Channel D off after two minutes",
			"timers": [{"id": "off", "duration": {"kind": "literal", "type": "duration", "value": 120000}}],
			"reactions": [
				{
					"triggers": [{"kind": "datapoint", "datapoint": "chD.state"}],
					"condition": {"kind": "call", "function": "coalesce",
						"args": [{"kind": "datapoint", "name": "chD.state"}, {"kind": "literal", "type": "boolean", "value": false}]},
					"actions": [{"kind": "restartTimer", "timer": "off"}],
					"elseActions": [{"kind": "cancelTimer", "timer": "off"}]
				},
				{
					"triggers": [{"kind": "timer", "timer": "off"}],
					"actions": [{"kind": "write", "datapoint": "chD", "value": {"kind": "literal", "type": "boolean", "value": false}}]
				}
			]
		}
	],
	"history": {"budget": 16384},
