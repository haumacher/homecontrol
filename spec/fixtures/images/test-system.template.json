		{"id": "key-4", "label": "Key 4", "room": "panel", "kind": "button", "datapoints": {"press": "key4"}},
		{"id": "key-5", "label": "Key 5", "room": "panel", "kind": "button", "datapoints": {"press": "key5"}},
