{"comment": "Adjustable schedule members (spec/schedules.md 2.1, issue #58): every member each kind allows, with bounds and steps; the entries with an adjustable time imply the datapoints schedule/<id>/time (2.2), which a rule reads like any datapoint and a function or page names.",
 "expect": {"valid": true},
 "image": {"schemaVersion": "1.2", "projectId": "case", "revision": 1},
 "datapoints": [{"id": "blinds.up", "type": "boolean", "writable": true, "virtual": {}}],
 "schedules": [
   {"id": "workdayMorning", "label": "Workday morning", "kind": "weekly", "days": [1, 2, 3, 4, 5],
    "time": {"hour": 6, "minute": 30, "second": 0}, "adjustable": ["time", "days"],
    "bounds": {"time": {"min": {"hour": 5, "minute": 0, "second": 0}, "max": {"hour": 9, "minute": 0, "second": 0}, "step": 300}}},
   {"id": "weekendMorning", "label": "Weekend morning", "kind": "weekly", "days": [6, 7],
    "time": {"hour": 8, "minute": 0, "second": 0}, "adjustable": ["time"]},
   {"id": "christmasEve", "label": "Christmas Eve", "kind": "yearly", "month": 12, "day": 24,
    "time": {"hour": 17, "minute": 0, "second": 0}, "adjustable": ["time"], "bounds": {"time": {"step": 900}}},
   {"id": "trash", "label": "Bin collection", "kind": "dates", "dates": [{"year": 2027, "month": 1, "day": 8}],
    "time": {"hour": 6, "minute": 15, "second": 0}, "adjustable": ["time"],
    "bounds": {"time": {"min": {"hour": 5, "minute": 0, "second": 0}, "max": {"hour": 8, "minute": 0, "second": 0}}}},
   {"id": "blindsEvening", "label": "Blinds down at dusk", "kind": "astro", "sun": "sunset", "offset": -1800000,
    "notBefore": {"hour": 17, "minute": 0, "second": 0}, "notAfter": {"hour": 22, "minute": 0, "second": 0},
    "adjustable": ["offset", "notBefore", "notAfter", "days"],
    "bounds": {"offset": {"min": -3600000, "max": 3600000, "step": 300000},
               "notAfter": {"min": {"hour": 20, "minute": 0, "second": 0}, "max": {"hour": 23, "minute": 0, "second": 0}, "step": 1800}}},
   {"id": "circulation", "label": "Hot water circulation", "kind": "interval", "every": 900000,
    "from": {"hour": 6, "minute": 0, "second": 0}, "until": {"hour": 22, "minute": 0, "second": 0},
    "adjustable": ["every", "from", "until", "days"], "bounds": {"every": {"min": 300000, "max": 3600000, "step": 300000}}},
   {"id": "partyEnd", "label": "Party ends", "kind": "once",
    "at": {"year": 2026, "month": 12, "day": 31, "hour": 23, "minute": 59, "second": 0}, "adjustable": ["at"],
    "bounds": {"at": {"min": {"year": 2026, "month": 12, "day": 31, "hour": 20, "minute": 0, "second": 0},
                      "max": {"year": 2027, "month": 1, "day": 1, "hour": 4, "minute": 0, "second": 0}}}}],
 "rules": [
   {"id": "early", "name": "Early riser",
    "reactions": [{"triggers": [{"kind": "schedule", "schedule": "workdayMorning"}],
                   "condition": {"kind": "binary", "op": "<", "left": {"kind": "datapoint", "name": "schedule/workdayMorning/time"},
                                 "right": {"kind": "literal", "type": "timeOfDay", "value": {"hour": 6, "minute": 0, "second": 0}}},
                   "actions": [{"kind": "write", "datapoint": "blinds.up", "value": {"kind": "literal", "type": "boolean", "value": true}}]}]}]}
