# Shared by the application project (platform/esp) and the OTA updater (platform/esp/updater);
# included before the IDF's project.cmake. Selects the partition table of the asymmetric OTA layout
# for the board's flash size and sets the app version from the core's hc::kVersion.
#
#   HC_FLASH_SIZE   4MB (default, the development C6), 8MB or 16MB: the board's flash. Chosen at the
#                   first configure of a build directory (-D HC_FLASH_SIZE=8MB) and cached there.
#
# The flash size and the table (platform/esp/partitions-<size>.csv, generated by
# tools/gen_partitions.py) go into a small sdkconfig fragment in the build directory that is
# appended to the project's sdkconfig.defaults. Like every default, it applies only when the
# build's sdkconfig is created: after changing HC_FLASH_SIZE delete <build>/sdkconfig.

set(HC_ESP_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(HC_FLASH_SIZES 4MB 8MB 16MB)
set(HC_FLASH_SIZE "4MB" CACHE STRING "Flash size of the board: 4MB, 8MB or 16MB (selects partitions-<size>.csv)")
set_property(CACHE HC_FLASH_SIZE PROPERTY STRINGS ${HC_FLASH_SIZES})
if(NOT HC_FLASH_SIZE IN_LIST HC_FLASH_SIZES)
	message(FATAL_ERROR "HC_FLASH_SIZE=${HC_FLASH_SIZE} is not supported; use one of ${HC_FLASH_SIZES}")
endif()
set(HC_PARTITION_CSV "${HC_ESP_DIR}/partitions-${HC_FLASH_SIZE}.csv")

set(HC_FLASH_DEFAULTS "${CMAKE_BINARY_DIR}/sdkconfig.flash")
set(_hc_flash_defaults_text "# Generated by platform/esp/hc_project.cmake for HC_FLASH_SIZE=${HC_FLASH_SIZE}
CONFIG_ESPTOOLPY_FLASHSIZE_${HC_FLASH_SIZE}=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${HC_PARTITION_CSV}\"
")
file(WRITE "${HC_FLASH_DEFAULTS}" "${_hc_flash_defaults_text}")

# Appends the fragment to the project's defaults list (call after setting SDKCONFIG_DEFAULTS).
macro(hc_add_flash_defaults)
	list(APPEND SDKCONFIG_DEFAULTS "${HC_FLASH_DEFAULTS}")
endmacro()

# After project(): refuses a build whose sdkconfig was created for another table (a stale
# sdkconfig from before the OTA layout, or HC_FLASH_SIZE changed).
function(hc_check_partition_table)
	if(NOT CONFIG_PARTITION_TABLE_CUSTOM OR NOT CONFIG_PARTITION_TABLE_CUSTOM_FILENAME STREQUAL HC_PARTITION_CSV)
		message(FATAL_ERROR "The sdkconfig of ${CMAKE_BINARY_DIR} does not use ${HC_PARTITION_CSV} "
			"(it was created before the OTA layout or for another HC_FLASH_SIZE). "
			"Delete ${CMAKE_BINARY_DIR}/sdkconfig and build again.")
	endif()
	if(NOT CONFIG_ESPTOOLPY_FLASHSIZE STREQUAL HC_FLASH_SIZE)
		message(FATAL_ERROR "The sdkconfig of ${CMAKE_BINARY_DIR} has flash size ${CONFIG_ESPTOOLPY_FLASHSIZE}, "
			"HC_FLASH_SIZE is ${HC_FLASH_SIZE}. Delete ${CMAKE_BINARY_DIR}/sdkconfig and build again.")
	endif()
endfunction()

# HC_EXTRA_CA (development only): a PEM file of CA certificates the application trusts in addition
# to the IDF's certificate bundle, e.g. the local CA of a TLS proxy in front of a development E-Home
# (doc/ehome.md "TLS during development"). It switches on the IDF's custom bundle
# (CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE) through a second sdkconfig fragment; empty (the
# default) leaves the bundle as released. Like HC_FLASH_SIZE it applies when the build's sdkconfig
# is created, and hc_check_extra_ca() refuses a build whose sdkconfig does not match it, in both
# directions, so a development CA cannot stay in a build configured without one.
set(HC_EXTRA_CA "" CACHE FILEPATH "PEM file of additional trusted CA certificates (development only)")
set(HC_EXTRA_CA_DEFAULTS "${CMAKE_BINARY_DIR}/sdkconfig.extra_ca")
if(HC_EXTRA_CA)
	get_filename_component(_hc_extra_ca "${HC_EXTRA_CA}" ABSOLUTE)
	if(NOT EXISTS "${_hc_extra_ca}")
		message(FATAL_ERROR "HC_EXTRA_CA=${HC_EXTRA_CA} does not exist")
	endif()
	set(HC_EXTRA_CA "${_hc_extra_ca}" CACHE FILEPATH "PEM file of additional trusted CA certificates (development only)" FORCE)
	file(WRITE "${HC_EXTRA_CA_DEFAULTS}" "# Generated by platform/esp/hc_project.cmake for HC_EXTRA_CA
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH=\"${_hc_extra_ca}\"
")
else()
	file(WRITE "${HC_EXTRA_CA_DEFAULTS}" "# Generated by platform/esp/hc_project.cmake: no HC_EXTRA_CA
")
endif()

# Appends the HC_EXTRA_CA fragment to the defaults list (the application only).
macro(hc_add_extra_ca_defaults)
	list(APPEND SDKCONFIG_DEFAULTS "${HC_EXTRA_CA_DEFAULTS}")
endmacro()

# After project(): refuses a build whose sdkconfig does not match HC_EXTRA_CA.
function(hc_check_extra_ca)
	if(HC_EXTRA_CA)
		if(NOT CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE OR NOT CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH STREQUAL HC_EXTRA_CA)
			message(FATAL_ERROR "The sdkconfig of ${CMAKE_BINARY_DIR} does not trust HC_EXTRA_CA=${HC_EXTRA_CA}. "
				"Delete ${CMAKE_BINARY_DIR}/sdkconfig and build again.")
		endif()
		message(STATUS "Development build: trusts the CA certificates of ${HC_EXTRA_CA} in addition to the bundle")
	elseif(CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE)
		message(FATAL_ERROR "The sdkconfig of ${CMAKE_BINARY_DIR} trusts extra CA certificates "
			"(${CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH}) but HC_EXTRA_CA is empty. "
			"Delete ${CMAKE_BINARY_DIR}/sdkconfig and build again.")
	endif()
endfunction()

# The app descriptor's version is the core's hc::kVersion (core/include/hc/version.h), so the
# updater can check that a downloaded image is the version the manifest announced.
file(STRINGS "${HC_ESP_DIR}/../../core/include/hc/version.h" _hc_version_line
	REGEX "constexpr const char\\* kVersion = \"[^\"]+\"")
string(REGEX REPLACE ".*kVersion = \"([^\"]+)\".*" "\\1" HC_VERSION "${_hc_version_line}")
if(HC_VERSION STREQUAL "" OR HC_VERSION STREQUAL _hc_version_line)
	message(FATAL_ERROR "cannot read hc::kVersion from core/include/hc/version.h")
endif()
set(PROJECT_VER "${HC_VERSION}")
