# The updater does not build hc_net; the options it shares with the application are declared here
# under the same names, and their values come from ../sdkconfig.defaults.

menu "HomeControl network"

	config HC_WIFI_MAX_TX_POWER
		int "Maximum WiFi transmit power (quarter dBm, 8..84)"
		range 8 84
		default 80
		help
			The same limit as the application's (components/hc_net/Kconfig): passed to
			esp_wifi_set_max_tx_power() when the station starts. The project default (44, 11 dBm)
			comes from platform/esp/sdkconfig.defaults; the development C6 browns out at full power
			(doc/hardware.md).

	config HC_WPS_BUTTON_GPIO
		int "GPIO of the WPS button (active low; -1: no button)"
		range -1 48
		default 9 if IDF_TARGET_ESP32C6
		default 0 if IDF_TARGET_ESP32S3
		default -1
		help
			The application's WPS button (components/hc_net/Kconfig). In the updater, while ota_0
			holds no bootable application, holding it for 3 s authorizes an upload from the browser
			for 5 minutes without the one-time token (doc/ota.md "Recovery with the button").

endmenu

menu "HomeControl updater testing"

	config HC_UPDATER_TEST_BUTTON_WINDOW
		bool "TEST ONLY: take the idle path and open the button window without the button"
		default n
		help
			For tests of the recovery path (#69) without erasing the application: the decision
			treats ota_0 as holding no application (so the updater waits idle, as after a broken
			update), and the idle wait acts as if the button had been held for 3 s once the updater
			has run HC_UPDATER_TEST_BUTTON_WINDOW_AFTER_S seconds. An upload then needs no token
			(anyone on the network can flash): never enable it in a build that leaves the desk. The
			updater logs a warning at every boot while it is on. Reach the updater by erasing
			otadata (doc/ota.md, "Testing the recovery path").

	config HC_UPDATER_TEST_BUTTON_WINDOW_AFTER_S
		int "Seconds since boot before the test window opens"
		depends on HC_UPDATER_TEST_BUTTON_WINDOW
		range 0 3600
		default 0

endmenu
