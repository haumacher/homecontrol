# Host build
/build/
/build-*/
/platform/posix/build/
# ESP-IDF
/platform/esp/build/
/platform/esp/build-*/
/platform/esp/updater/build/
/platform/esp/updater/build-*/
/platform/esp/updater/managed_components/
/platform/esp/sdkconfig
/platform/esp/sdkconfig.old
/platform/esp/managed_components/
# Tooling
/.playwright-mcp/
/recording.json
/tmp/
*.log
__pycache__/
.vscode/
.idea/
# Host settings file (may hold a WiFi key)
homecontrol.settings
# The development release key scripts/update-server.py generates (doc/ota.md "Manifest signature"):
# a private key never enters the repository
/scripts/dev-release-key
/scripts/dev-release-key.pub
# Web flasher: local copies of the firmware (scripts/flasher-local.sh), never versioned
/web/flasher/firmware/
# Language packs copied by the POSIX build from web/ui/lang (doc/i18n.md); only the base is versioned here
/web/ui/dist/lang/*
!/web/ui/dist/lang/en.json
# The WebAssembly block spike (spike/blocks-wasm, doc/blocks-wasm.md): build outputs and fetched code
/spike/blocks-wasm/esp/build-*/
/spike/blocks-wasm/esp/managed_components/
/spike/blocks-wasm/esp/sdkconfig
/spike/blocks-wasm/esp/sdkconfig.old
/spike/blocks-wasm/blocks/rust/target/
/spike/blocks-wasm/blocks/c/bulk.c
/spike/blocks-wasm/java/target/
